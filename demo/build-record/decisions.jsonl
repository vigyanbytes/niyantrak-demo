{"agent_id": "Claude Code", "kind": "DECISION", "product": "niyantrak", "session_id": "build-record", "src": "BR-DEC-05", "title": "Free edition under Apache-2.0; Pro, Enterprise and Government are commercial", "ts": "2026-10-23T12:00:00.000000000", "user_id": "founder"}
